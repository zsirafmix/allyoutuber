# ==========================================
# AllYouTuber Environment Configuration
# ==========================================

# Port and Environment
PORT=3000
NODE_ENV=production
APP_URL=https://allyoutuber.onrender.com

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname:5432/allyoutuber?schema=public"

# YouTube Data API v3 (Optional: oEmbed & scraper fallback enabled if omitted)
YOUTUBE_API_KEY=""

# Security & Sessions
SESSION_SECRET="change-this-to-a-secure-random-32-character-secret"
ADMIN_BOOTSTRAP_TOKEN="super-secret-admin-bootstrap-token-12345"

# Optional Redis URL (for horizontal scaling with Socket.IO Redis Adapter)
# REDIS_URL="redis://localhost:6379"
